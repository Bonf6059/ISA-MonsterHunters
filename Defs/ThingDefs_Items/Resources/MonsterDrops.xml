<?xml version="1.0" encoding="utf-8" ?>

<Defs>

	<!--============================== Alchemy Ingredients ===================================-->
	<ThingDef ParentName="ResourceBase" Name="ISA_AlchemyIngredientsBase" Abstract="True">
		<resourceReadoutPriority>Middle</resourceReadoutPriority>
		<stackLimit>50</stackLimit>

		<thingCategories>
			<li>ResourcesRaw</li>
		</thingCategories>
		<tradeTags>
			<li>ISA_AlchemyIngredients</li>
		</tradeTags>
	</ThingDef>
	
	<!--=============== Unhold Drops ===============-->

	<ThingDef ParentName="ISA_AlchemyIngredientsBase">
		<defName>ISA_UnholdHeart</defName>
		<label>unhold heart</label>
		<description>The beating heart of the fearsome unhold, pulsing with primal power and ancient vitality, considered to be a key ingredient for creating elixirs of endurance.</description>
		<graphicData>
			<texPath>Items/Resources/MonsterDrops/Unhold/UnholdHeart</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>

		<statBases>
			<MarketValue>280</MarketValue>
			<MaxHitPoints>100</MaxHitPoints>
			<Mass>1</Mass>
			<Flammability>0.3</Flammability>
			<DeteriorationRate>0</DeteriorationRate>
		</statBases>
	</ThingDef>

	<ThingDef ParentName="ISA_AlchemyIngredientsBase">
		<defName>ISA_ThickUnholdFur</defName>
		<label>thick unhold fur</label>
		<description>Warm furs of the formidable unhold, renowned for their thickness and weatherproof nature, sought after for crafting resilient garments and protective gear.</description>
		<graphicData>
			<texPath>Items/Resources/MonsterDrops/Unhold/ThickUnholdFur</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>

		<statBases>
			<MarketValue>375</MarketValue>
			<MaxHitPoints>150</MaxHitPoints>
			<Mass>15</Mass>
			<Flammability>0.8</Flammability>
			<DeteriorationRate>0</DeteriorationRate>
		</statBases>
	</ThingDef>

	<ThingDef ParentName="ISA_AlchemyIngredientsBase">
		<defName>ISA_UnholdHide</defName>
		<label>unhold hide</label>
		<description>Robust hides of the formidable unhold, renowned for their thickness and weatherproof nature, sought after for crafting resilient garments and protective gear.</description>
		<graphicData>
			<texPath>Items/Resources/MonsterDrops/Unhold/UnholdHide</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>

		<statBases>
			<MarketValue>250</MarketValue>
			<MaxHitPoints>100</MaxHitPoints>
			<Mass>10</Mass>
			<Flammability>0.4</Flammability>
			<DeteriorationRate>0</DeteriorationRate>
		</statBases>
	</ThingDef>

	<!--=============== Lindwurm Drops ===============-->
	
	<ThingDef ParentName="ISA_AlchemyIngredientsBase">
		<defName>ISA_LindwurmBlood</defName>
		<label>lindwurm blood</label>
		<description>The acidic blood of a Lindwurm, carefully preserved in glass. Highly corrosive in nature, it can melt through plate armor in a matter of seconds. Due to it’s offensive capabilities, it is highly sought for by alchemists and hunters.</description>
		<graphicData>
			<texPath>Items/Resources/MonsterDrops/Lindwurm/LindwurmBlood</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>

		<statBases>
			<MarketValue>500</MarketValue>
			<MaxHitPoints>100</MaxHitPoints>
			<Mass>3</Mass>
			<Flammability>0</Flammability>
			<DeteriorationRate>0</DeteriorationRate>
		</statBases>
	</ThingDef>

	<ThingDef ParentName="ISA_AlchemyIngredientsBase">
		<defName>ISA_LindwurmScales</defName>
		<label>lindwurm broad scales</label>
		<description>Tough, durable scales shed from a Lindwurm, prized for their exceptional strength and resilience. Ideal for crafting high-quality armor and protective gear.</description>
		<graphicData>
			<texPath>Items/Resources/MonsterDrops/Lindwurm/LindwurmScales</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>

		<statBases>
			<MarketValue>750</MarketValue>
			<MaxHitPoints>150</MaxHitPoints>
			<Mass>15</Mass>
			<Flammability>0</Flammability>
			<DeteriorationRate>0</DeteriorationRate>
		</statBases>
	</ThingDef>

	<!--=============== Alp ===============-->

	<ThingDef ParentName="ISA_AlchemyIngredientsBase">
		<defName>ISA_PetrifiedScream</defName>
		<label>petrified scream</label>
		<description>A unique part of Alp biology, this solidified manifestation of the creature's final cry is a rare and eerie material used in crafting or dark rituals.</description>
		<graphicData>
			<texPath>Items/Resources/MonsterDrops/Alp/PetrifiedScream</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>

		<statBases>
			<MarketValue>185</MarketValue>
			<MaxHitPoints>60</MaxHitPoints>
			<Mass>1</Mass>
			<Flammability>2</Flammability>
			<DeteriorationRate>0</DeteriorationRate>
		</statBases>
	</ThingDef>

	<ThingDef ParentName="ISA_AlchemyIngredientsBase">
		<defName>ISA_ThirdEye</defName>
		<label>third eye</label>
		<description>A mystical organ from an Alp, known for its ability to perceive beyond the physical realm. Often sought after for use in powerful rituals or crafting items with enhanced perception or psychic abilities.</description>
		<graphicData>
			<texPath>Items/Resources/MonsterDrops/Alp/ThirdEye</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>

		<statBases>
			<MarketValue>185</MarketValue>
			<MaxHitPoints>40</MaxHitPoints>
			<Mass>1</Mass>
			<Flammability>0.5</Flammability>
			<DeteriorationRate>0</DeteriorationRate>
		</statBases>
	</ThingDef>

	<ThingDef ParentName="ISA_AlchemyIngredientsBase">
		<defName>ISA_ParchedSkin</defName>
		<label>parched skin</label>
		<description>Soft yet durable hide from an Alp, often used to craft lightweight armor or clothing with subtle protective qualities.</description>
		<graphicData>
			<texPath>Items/Resources/MonsterDrops/Alp/ParchedSkin</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>

		<statBases>
			<MarketValue>150</MarketValue>
			<MaxHitPoints>40</MaxHitPoints>
			<Mass>1</Mass>
			<Flammability>2</Flammability>
			<DeteriorationRate>0</DeteriorationRate>
		</statBases>
	</ThingDef>

	<!--=============== Dire Wolf ===============-->
	<ThingDef ParentName="ISA_AlchemyIngredientsBase">
		<defName>ISA_AdrenalineGland</defName>
		<label>adrenaline gland</label>
		<description>This organ significantly enhances the body's fight-or-flight response, increasing strength, speed, and reaction time when activated. Often used in crafting potent combat stimulants.</description>
		<graphicData>
			<texPath>Items/Resources/MonsterDrops/Direwolf/AdrenalineGland</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>

		<statBases>
			<MarketValue>100</MarketValue>
			<MaxHitPoints>40</MaxHitPoints>
			<Mass>1</Mass>
			<Flammability>0.5</Flammability>
			<DeteriorationRate>1</DeteriorationRate>
		</statBases>
	</ThingDef>

	<!--=============== Rox horn ===============-->
	
	<ThingDef ParentName="ResourceVerbBase">
		<defName>ISA_RoxHorn</defName>
		<label>Rox Horn</label>
		<description>A Rox's horn. It is heavy, durable, and valuable. It is too bulky to be used as a weapon.</description>
		<graphicData>
			<texPath>Items/Resources/MonsterDrops/Rox/RoxHorn</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<equippedAngleOffset>-20</equippedAngleOffset>

		<statBases>
			<MarketValue>100</MarketValue>
			<MaxHitPoints>200</MaxHitPoints>
			<Mass>2</Mass>
			<Flammability>0.5</Flammability>
			<DeteriorationRate>0.5</DeteriorationRate>
		</statBases>

		<resourceReadoutPriority>Middle</resourceReadoutPriority>
		<stackLimit>10</stackLimit>
		<relicChance>2</relicChance>

		<comps>
			<li Class="CompProperties_Styleable"/>
		</comps>
		<weaponClasses>
			<li>Melee</li>
			<li>MeleeBlunt</li>
		</weaponClasses>
		<tools>
			<li>
				<label>ram</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>16.2</power>
				<cooldownTime>2.7</cooldownTime>
			</li>
			<li>
				<label>base</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
				<chanceFactor>0.5</chanceFactor>
			</li>
		</tools>
		<thingCategories>
			<li>Items</li>
		</thingCategories>
		<tradeTags>
			<li>ExoticMisc</li>
		</tradeTags>
		<thingSetMakerTags>
			<li>AnimalPart</li>
		</thingSetMakerTags>
	</ThingDef>

</Defs>
