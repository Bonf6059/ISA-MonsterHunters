	<!-- Lindwurm Leather -->
	
	<ThingDef ParentName="LeatherBase">
		<defName>ISA_Leather_Lindwurm</defName>
		<label>lindwurm scales</label>
		<description>A broad green husks size of a hand, tinting the reflected light emerald. Material both durable and elegant, attracting envious glances.</description>
		<graphicData>
			<texPath>Items/Resources/MonsterDrops/Lindwurm/LindwurmScales</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
