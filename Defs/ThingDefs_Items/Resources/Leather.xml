<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!-- Mettere come ParentName LeatherBase e aggiungere tutte le stat mancanti in tutti tranne direwolf --> 
	
	<!-- Direworlf Leather -->

	<ThingDef ParentName="LeatherBase">
		<defName>ISA_Leather_Direwolf</defName>
		<label>wolfskin</label>
		<description>A strong furry pelt harvested from a vicious direwolf. Harder than regular wolf pelt and insulates well against cold.</description>
		<graphicData>
			<texPath>Things/Item/Resource/Leather</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
			<color>(69,63,58)</color>
		</graphicData>
		<statBases>
			<MarketValue>3.4</MarketValue>
			<StuffPower_Armor_Sharp>1.12</StuffPower_Armor_Sharp>
			<StuffPower_Insulation_Cold>24</StuffPower_Insulation_Cold>
		</statBases>
		<stuffProps>
			<color>(69,63,58)</color>
			<commonality>0.075</commonality>
			<statFactors>
				<Beauty>1.80</Beauty>
			</statFactors>
		</stuffProps>
	</ThingDef>

	<!-- Unhold Leather -->
	
	<ThingDef ParentName="ISA_AlchemyIngredientsBase">
		<defName>ISA_ThickUnholdFur</defName>
		<label>thick unhold fur</label>
		<description>Warm furs of the formidable unhold, renowned for their thickness and weatherproof nature, sought after for crafting resilient garments and protective gear.</description>
		<graphicData>
			<texPath>Items/Resources/MonsterDrops/Unhold/ThickUnholdFur</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>

		<statBases>
			<MarketValue>375</MarketValue>
			<MaxHitPoints>150</MaxHitPoints>
			<Mass>15</Mass>
			<Flammability>0.8</Flammability>
			<DeteriorationRate>0</DeteriorationRate>
		</statBases>
	</ThingDef>

	<ThingDef ParentName="ISA_AlchemyIngredientsBase">
		<defName>ISA_UnholdHide</defName>
		<label>unhold hide</label>
		<description>Robust hides of the formidable unhold, renowned for their thickness and weatherproof nature, sought after for crafting resilient garments and protective gear.</description>
		<graphicData>
			<texPath>Items/Resources/MonsterDrops/Unhold/UnholdHide</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>

		<statBases>
			<MarketValue>250</MarketValue>
			<MaxHitPoints>100</MaxHitPoints>
			<Mass>10</Mass>
			<Flammability>0.4</Flammability>
			<DeteriorationRate>0</DeteriorationRate>
		</statBases>
	</ThingDef>

	<!-- Linduwrm -->
	
	<ThingDef ParentName="ISA_AlchemyIngredientsBase">
		<defName>ISA_LindwurmScales</defName>
		<label>lindwurm broad scales</label>
		<description>Tough, durable scales shed from a Lindwurm, prized for their exceptional strength and resilience. Ideal for crafting high-quality armor and protective gear.</description>
		<graphicData>
			<texPath>Items/Resources/MonsterDrops/Lindwurm/LindwurmScales</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>

		<statBases>
			<MarketValue>750</MarketValue>
			<MaxHitPoints>150</MaxHitPoints>
			<Mass>15</Mass>
			<Flammability>0</Flammability>
			<DeteriorationRate>0</DeteriorationRate>
		</statBases>
	</ThingDef>

<!-- Alp -->

	<ThingDef ParentName="ISA_AlchemyIngredientsBase">
		<defName>ISA_ParchedSkin</defName>
		<label>parched skin</label>
		<description>Soft yet durable hide from an Alp, often used to craft lightweight armor or clothing with subtle protective qualities.</description>
		<graphicData>
			<texPath>Items/Resources/MonsterDrops/Alp/ParchedSkin</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>

		<statBases>
			<MarketValue>150</MarketValue>
			<MaxHitPoints>40</MaxHitPoints>
			<Mass>1</Mass>
			<Flammability>2</Flammability>
			<DeteriorationRate>0</DeteriorationRate>
		</statBases>
	</ThingDef>
	
</Defs>
