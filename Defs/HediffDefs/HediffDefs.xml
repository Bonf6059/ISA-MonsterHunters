<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!-- Paralize -->
  
	<HediffDef>
		<defName>ISA_Paralize</defName>
		<label>Paralized</label>
		<makesSickThought>false</makesSickThought>
		<description>Paralyzed by a powerful venom.</description>
		<tendable>false</tendable>
		<isBad>false</isBad>
		<defaultLabelColor>(1,0,0.5)</defaultLabelColor>
		<hediffClass>HediffWithComps</hediffClass>
		<initialSeverity>1.0</initialSeverity>
		<maxSeverity>1.0</maxSeverity>
		<comps>
			<li Class="HediffCompProperties_SeverityPerDay">
				<severityPerDay>-0.5</severityPerDay>
				<showHoursToRecover>true</showHoursToRecover>
			</li>
		</comps>
		<stages>
			<li>
				<hungerRateFactorOffset>0.1</hungerRateFactorOffset>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<setMax>0.1</setMax>
					</li>
				</capMods>
			</li>
		</stages>
	</HediffDef>

<!-- Petrification -->
	
	<HediffDef>
    <defName>ISA_Petrify</defName>
    <label>Petrified</label>
    <description>Paralyzed by a powerful venom.</description>
	<hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(214,197,77)</defaultLabelColor>
    <maxSeverity>2</maxSeverity>
    <isBad>true</isBad>
	
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-9.0</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
    </comps>
      <stages>
        <li>
		  <label>slowed</label>
          <statFactors>
            <MeleeDodgeChance>0.8</MeleeDodgeChance>
			<MeleeHitChance>0.8</MeleeHitChance>
			<ShootingAccuracyPawn>0.8</ShootingAccuracyPawn>
          </statFactors>
		  
          <capMods>
            <li>
              <capacity>Moving</capacity>
              <offset>-0.15</offset>
            </li>
          </capMods>
		  
        </li>
		
        <li>
		  <minSeverity>1.5</minSeverity>
		  <label>petrified</label>
          <statFactors>
          </statFactors>
		  
          <capMods>
            <li>
              <capacity>Moving</capacity>
              <offset>-1</offset>
            </li>
          </capMods>
		  
        </li>
      </stages>
  </HediffDef>

<!-- Acid -->

  <HediffDef ParentName="DiseaseBase">
		<defName>ISA_LindwurmAcid</defName>
		<label>lindwurm acid</label>
		<description>Powerful acid from the blood of a lindwurm. Corrodes the durability of armor.</description>
    <defaultLabelColor>(71,155,55)</defaultLabelColor>
    <maxSeverity>3</maxSeverity>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-3.0</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
    </comps>
      <stages>
        
        <li>
		      <label>burning</label>
          <painFactor>1.1</painFactor>
          <statFactors>
          <MeleeDodgeChance>0.8</MeleeDodgeChance>
	        <IncomingDamageFactor>1.2</IncomingDamageFactor>
          </statFactors>
        </li>
		
        <li>
		      <minSeverity>1.5</minSeverity>
		      <label>scorching</label>
		      <painFactor>1.4</painFactor>
          <statFactors>
          <MeleeDodgeChance>0.5</MeleeDodgeChance>
	        <IncomingDamageFactor>1.5</IncomingDamageFactor>
          </statFactors>
        </li>
        
        <li>
          <minSeverity>2.5</minSeverity>
          <label>blistering</label>
		      <painFactor>1.7</painFactor>
          <statFactors>
          <MeleeDodgeChance>0.2</MeleeDodgeChance>
	        <IncomingDamageFactor>2</IncomingDamageFactor>
          </statFactors>
        </li>
        
      </stages>
  </HediffDef>
  
</Defs>
