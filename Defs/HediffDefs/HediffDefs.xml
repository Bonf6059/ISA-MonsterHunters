<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	
<!-- Lyndwurm Acid -->

  <HediffDef ParentName="DiseaseBase">
		<defName>ISA_LindwurmAcid</defName>
		<label>lindwurm acid</label>
		<description>Powerful acid from the blood of a lindwurm. Corrodes the durability of armor.</description>
    <defaultLabelColor>(71,155,55)</defaultLabelColor>
    <maxSeverity>3</maxSeverity>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-3.0</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
		
			<!-- DISATTIVATO PERCHè NON MI RICORDO COSA FA painFactor MA è UNA VALIDA ALTERNATIVA, FORSE-->
			
		<!--	<li Class="EBSGFramework.HediffCompProperties_DamageOverTime">
                <damage>Burn</damage>
                <createFilth>False</createFilth>
                <damageAttachedPart>True</damageAttachedPart>
            </li>	-->
		
    </comps>
      <stages>
        
        <li>
		      <label>burning</label>
          <painFactor>1.1</painFactor>
          <statFactors>
          <MeleeDodgeChance>0.8</MeleeDodgeChance>
	        <IncomingDamageFactor>1.2</IncomingDamageFactor>
          </statFactors>
        </li>
		
        <li>
		      <minSeverity>1.5</minSeverity>
		      <label>scorching</label>
		      <painFactor>1.4</painFactor>
          <statFactors>
          <MeleeDodgeChance>0.5</MeleeDodgeChance>
	        <IncomingDamageFactor>1.5</IncomingDamageFactor>
          </statFactors>
        </li>
        
        <li>
          <minSeverity>2.5</minSeverity>
          <label>blistering</label>
		      <painFactor>1.7</painFactor>
          <statFactors>
          <MeleeDodgeChance>0.2</MeleeDodgeChance>
	        <IncomingDamageFactor>2</IncomingDamageFactor>
          </statFactors>
        </li>
        
      </stages>
  </HediffDef>

<!-- Alp sleep -->
	
<HediffDef>
	<defName>ISA_AlpSleep</defName>
	<label>magical sleep</label>
	<description>A temporary state of mind that hinders combat effectiveness.</description>
	<hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(214,197,77)</defaultLabelColor>
    <maxSeverity>2</maxSeverity>
    <isBad>true</isBad>
	
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-9.0</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
    </comps>
      <stages>
        <li>
		  <label>slowed</label>
          <statFactors>
            <MeleeDodgeChance>0.8</MeleeDodgeChance>
			<MeleeHitChance>0.8</MeleeHitChance>
			<ShootingAccuracyPawn>0.8</ShootingAccuracyPawn>
          </statFactors>
		  
          <capMods>
            <li>
              <capacity>Moving</capacity>
              <offset>-0.15</offset>
            </li>
          </capMods>
		  
        </li>
		
        <li>
		  <minSeverity>1.5</minSeverity>
		  <label>hypnotized</label>
          <statFactors>
          </statFactors>
		  
          <capMods>
            <li>
              <capacity>Moving</capacity>
              <offset>-1</offset>
            </li>
          </capMods>
		  
        </li>
      </stages>
  </HediffDef>

<!-- Alp nightmare -->
	
	<HediffDef ParentName="InjuryBase">
		<defName>ISA_NightmareDamage</defName>
		<label>mental trauma</label>
		<labelNoun>mental trauma</labelNoun>
		<description>mental trauma</description>
		<comps>
		  <li Class="HediffCompProperties_TendDuration">
			<labelTendedWell>set</labelTendedWell>
			<labelTendedWellInner>set</labelTendedWellInner>
			<labelSolidTendedWell>set</labelSolidTendedWell>
		  </li>
		</comps>
		<injuryProps>
		  <painPerSeverity>0.01</painPerSeverity>
		  <averagePainPerSeverityPermanent>0.00625</averagePainPerSeverityPermanent>
		</injuryProps>
	  </HediffDef>

</Defs>
